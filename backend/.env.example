# Database
DATABASE_URL="postgresql://license_manager:license_manager_password@localhost:5432/license_manager"

# Server
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Observium Integration
OBSERVIUM_ENABLED=true
OBSERVIUM_URL=https://your-observium-server
OBSERVIUM_USERNAME=api-user
OBSERVIUM_PASSWORD=api-password
OBSERVIUM_SYNC_CRON=0 2 * * *  # Daily at 2 AM

# Netbox Integration (DCIM)
NETBOX_ENABLED=true
NETBOX_URL=https://netbox.yourcompany.com
NETBOX_API_TOKEN=your-netbox-api-token
NETBOX_SYNC_CRON=0 6 * * *  # Daily at 6 AM

# Juniper Networks API (optional)
JUNIPER_API_ENABLED=false
JUNIPER_API_URL=https://api.juniper.net
JUNIPER_API_KEY=your-api-key
JUNIPER_API_SECRET=your-api-secret

# Email Notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@example.com

# Alert Settings
ALERT_CONTRACT_EXPIRY_DAYS=90,60,30  # Send alerts at 90, 60, and 30 days before expiry
ALERT_LICENSE_EXPIRY_DAYS=60,30,7
