// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(VIEWER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

// ============================================
// HARDWARE MODELS (Master Data / Catalog)
// ============================================

model HardwareModel {
  id              String    @id @default(uuid())
  manufacturer    String    @default("Juniper Networks")
  modelName       String    @unique // e.g., "MX240", "EX4300-48T"
  modelType       ModelType
  description     String?
  technicalSpecs  Json? // Flexible field for various specs
  eolDate         DateTime? // End of Life
  eosDate         DateTime? // End of Support
  eolAnnouncedAt  DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assets HardwareAsset[]

  @@map("hardware_models")
}

enum ModelType {
  ROUTER
  SWITCH
  FIREWALL
  WIRELESS_AP
  CONTROLLER
  OTHER
}

// ============================================
// LOCATIONS
// ============================================

model Location {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets HardwareAsset[]

  @@map("locations")
}

// ============================================
// HARDWARE ASSETS (Physical Inventory)
// ============================================

model HardwareAsset {
  id              String       @id @default(uuid())
  modelId         String
  serialNumber    String       @unique
  assetTag        String?      @unique // Internal asset tag
  hostname        String? // From Observium or manual
  purchaseDate    DateTime?
  purchasePrice   Decimal?     @db.Decimal(10, 2)
  locationId      String?
  rackPosition    String?
  status          AssetStatus  @default(ACTIVE)
  owner           String? // Department or person
  notes           String?
  observiumId     Int?         @unique // Link to Observium device ID
  lastSyncAt      DateTime? // Last sync from Observium
  lastAuditDate   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  model              HardwareModel           @relation(fields: [modelId], references: [id])
  location           Location?               @relation(fields: [locationId], references: [id])
  licenses           AssetLicenseMapping[]
  contracts          AssetContractMapping[]
  observiumSyncLogs  ObserviumSyncLog[]
  billingMappings    AssetBillingMapping[]
  invoiceLineItems   InvoiceLineItem[]

  @@index([modelId])
  @@index([locationId])
  @@index([serialNumber])
  @@index([hostname])
  @@map("hardware_assets")
}

enum AssetStatus {
  ACTIVE
  SPARE
  DEFECT
  RETIRED
  IN_REPAIR
  MISSING
}

// ============================================
// SOFTWARE LICENSES
// ============================================

model License {
  id                  String        @id @default(uuid())
  licenseKey          String?       @unique
  licenseType         LicenseType
  softwareProduct     String // e.g., "Junos OS", "Juniper ATP"
  quantity            Int           @default(1)
  purchaseDate        DateTime?
  expiryDate          DateTime?
  cost                Decimal?      @db.Decimal(10, 2)
  vendorContractNumber String?
  notes               String?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  assets    AssetLicenseMapping[]
  contracts LicenseContractMapping[]

  @@map("licenses")
}

enum LicenseType {
  SUBSCRIPTION
  PERPETUAL
  FEATURE
  TRIAL
}

// ============================================
// MAINTENANCE CONTRACTS
// ============================================

model MaintenanceContract {
  id               String              @id @default(uuid())
  contractNumber   String              @unique
  contractType     ContractType
  category         ContractCategory    @default(HARDWARE) // Hardware or License
  vendor           String              @default("Juniper Networks")
  startDate        DateTime
  endDate          DateTime
  renewalDate      DateTime?
  annualCost       Decimal?            @db.Decimal(10, 2)
  serviceLevel     String?             // e.g., "24x7", "Business Hours"
  autoRenewal      Boolean             @default(false)
  notes            String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  assets           AssetContractMapping[]
  licenses         LicenseContractMapping[]
  alerts           ContractAlert[]
  invoiceLineItems InvoiceLineItem[]

  @@map("maintenance_contracts")
}

enum ContractType {
  JUNIPER_CARE
  PREMIUM_CARE
  THIRD_PARTY
  NLOGIC
  OTHER
}

enum ContractCategory {
  HARDWARE
  LICENSE
}

// Contract Types - manageable through UI (will replace enum)
model ContractTypeManagement {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contract_types")
}

// ============================================
// MAPPING TABLES (Many-to-Many)
// ============================================

model AssetLicenseMapping {
  id           String    @id @default(uuid())
  assetId      String
  licenseId    String
  assignedDate DateTime  @default(now())
  status       String    @default("active") // active, inactive
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset   HardwareAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  license License       @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([assetId, licenseId])
  @@index([assetId])
  @@index([licenseId])
  @@map("asset_license_mappings")
}

model AssetContractMapping {
  id             String              @id @default(uuid())
  assetId        String
  contractId     String
  coverageStart  DateTime
  coverageEnd    DateTime
  assetCost      Decimal?            @db.Decimal(10, 2) // Per-asset annual cost
  status         String              @default("active") // active, expired
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  asset    HardwareAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  contract MaintenanceContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([assetId, contractId])
  @@index([assetId])
  @@index([contractId])
  @@map("asset_contract_mappings")
}

model LicenseContractMapping {
  id             String              @id @default(uuid())
  licenseId      String
  contractId     String
  coverageStart  DateTime
  coverageEnd    DateTime
  licenseCost    Decimal?            @db.Decimal(10, 2) // Per-license annual cost
  status         String              @default("active") // active, expired
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  license  License              @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  contract MaintenanceContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([licenseId, contractId])
  @@index([licenseId])
  @@index([contractId])
  @@map("license_contract_mappings")
}

// ============================================
// OBSERVIUM INTEGRATION
// ============================================

model ObserviumSyncLog {
  id                String    @id @default(uuid())
  assetId           String?
  observiumDeviceId Int
  syncType          String // "create", "update", "skip"
  syncStatus        String // "success", "error"
  changes           Json? // What changed
  errorMessage      String?
  syncedAt          DateTime  @default(now())

  asset HardwareAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([observiumDeviceId])
  @@map("observium_sync_logs")
}

// ============================================
// ALERTS & NOTIFICATIONS
// ============================================

model ContractAlert {
  id          String              @id @default(uuid())
  contractId  String
  alertType   AlertType
  alertDate   DateTime // When the alert should fire
  sentAt      DateTime?
  status      AlertStatus         @default(PENDING)
  createdAt   DateTime            @default(now())

  contract MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([alertDate])
  @@map("contract_alerts")
}

enum AlertType {
  CONTRACT_EXPIRY_90
  CONTRACT_EXPIRY_60
  CONTRACT_EXPIRY_30
  LICENSE_EXPIRY_60
  LICENSE_EXPIRY_30
  LICENSE_EXPIRY_7
  EOL_ANNOUNCED
  EOS_ANNOUNCED
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

// ============================================
// BILLING AND INVOICE MANAGEMENT
// ============================================

model BillingGroup {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "H1-2025", "H2-2025"
  description String?
  billingType BillingType @default(SEMI_ANNUAL)
  periodStart DateTime
  periodEnd   DateTime
  isActive    Boolean  @default(true)
  maxAssets   Int? // Optional limit on assets per group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetMappings AssetBillingMapping[]
  invoiceRecords InvoiceRecord[]

  @@map("billing_groups")
}

enum BillingType {
  MONTHLY
  QUARTERLY  
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

model AssetBillingMapping {
  id             String    @id @default(uuid())
  assetId        String
  billingGroupId String
  assignedDate   DateTime  @default(now())
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  assignedBy     String? // User who assigned
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  asset        HardwareAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  billingGroup BillingGroup  @relation(fields: [billingGroupId], references: [id], onDelete: Cascade)

  @@unique([assetId, billingGroupId, effectiveFrom])
  @@index([assetId])
  @@index([billingGroupId])
  @@index([effectiveFrom])
  @@map("asset_billing_mappings")
}

model InvoiceRecord {
  id               String         @id @default(uuid())
  invoiceNumber    String         @unique
  billingGroupId   String
  vendor           String         @default("Juniper Networks")
  invoiceDate      DateTime
  dueDate          DateTime?
  totalAmount      Decimal?       @db.Decimal(12, 2)
  currency         String         @default("NOK")
  status           InvoiceStatus  @default(PENDING)
  paymentDate      DateTime?
  paidAmount       Decimal?       @db.Decimal(12, 2)
  notes            String?
  attachmentUrl    String? // Link to PDF/file
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  billingGroup BillingGroup @relation(fields: [billingGroupId], references: [id])
  lineItems    InvoiceLineItem[]

  @@index([billingGroupId])
  @@index([invoiceDate])
  @@index([status])
  @@map("invoice_records")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceLineItem {
  id            String   @id @default(uuid())
  invoiceId     String
  assetId       String?
  contractId    String?
  description   String
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(10, 2)
  totalPrice    Decimal  @db.Decimal(10, 2)
  billingPeriod String? // e.g., "2025-H1"
  createdAt     DateTime @default(now())

  invoice  InvoiceRecord     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  asset    HardwareAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  contract MaintenanceContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([assetId])
  @@index([contractId])
  @@map("invoice_line_items")
}

model BillingCycle {
  id           String       @id @default(uuid())
  name         String       @unique // e.g., "Semi-Annual 2025"
  billingType  BillingType
  frequency    Int          @default(2) // How many times per year
  description  String?
  isDefault    Boolean      @default(false)
  autoAssign   Boolean      @default(true) // Auto-assign new assets
  balanceThreshold Decimal? @db.Decimal(5, 2) // Max percentage difference between groups
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("billing_cycles")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  entityType String // "asset", "license", "contract", "billing"
  entityId   String
  action     String // "created", "updated", "deleted", "assigned", "unassigned"
  changes    Json? // What changed
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
